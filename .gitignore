pip-wheel-metadata/
build/
dist/
*.whl
*.egg
.eggs/
*.pid
*.pid.lock

# --- Command line client (agent-cli) ---------------------------------------
# `pip install -e .` / `pip wheel .` regenerates the packaging metadata of
# the `agent-cli` package in the repository root.
agent_cli.egg-info/
cli/__pycache__/

# --- Local tooling state ---------------------------------------------------
# Editor / agent session state, never part of the project.
.claude/

# --- Node / frontend --------------------------------------------------------
node_modules/
ui/node_modules/
ui/dist/
ui/coverage/
.vite/
ui/.vite/
.npm/
.yarn/
.pnp.*
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Application data -------------------------------------------------------
# The local RBAC database and the runtime state of the agent.
app_data/
.adk/
app/.adk/
# The ADK web server runs with agents_dir="." and stores per-agent session,
# artifact and memory state in "<agent>/.adk/" -- match that at any depth.
*/.adk/
data/
.cache/
.ipynb_checkpoints/

# Local SQLite databases and their sidecar files. The tracked provisioning
# data (grafana/dashboards/*.json, dataset/*.csv) is deliberately not matched.
#
# "*.db" covers the RBAC User & Role Store in every location it can end up:
# the app_data/ fallback (sqlite:///./app_data/rbac.db), a DATABASE_URL that
# points somewhere else in the tree, and the per-agent ADK session store.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# --- Generated audit exports and test output --------------------------------
audit_export*
*-audit-export.*
rbac-test-evidence/
test-results/
playwright-report/
junit*.xml

# --- Editors and logs -------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.orig
*.rej
*.log
server.log
logs/
.idea/
.vscode/
*.code-workspace
.fleet/
