{
  "registry_version": "1",
  "patterns": [
    {
      "pattern_id": "fabric_health",
      "index_pattern": "slingshot_crayfabrichealth-*",
      "domain_reference": "references/opensearch-logs/fabric-health.md",
      "enabled": true,
      "description": "Slingshot fabric health: heartbeat and fault documents",
      "date_rotation": {
        "style": "daily",
        "suffix": "-YYYY.MM.dd",
        "verified": false
      },
      "time_field": "@timestamp",
      "display_time_fields": [
        "fields.Timestamp",
        "timestamp"
      ],
      "max_window": "7d",
      "roles": {
        "health_state": [
          "fields.PhysicalSubContext"
        ],
        "event_kind": [
          "fields.PhysicalContext"
        ],
        "text": [
          "fields.Value"
        ],
        "entity_switch": [
          "fields.Switch"
        ],
        "entity_port": [
          "fields.Port"
        ],
        "entity_location": [
          "fields.Location"
        ],
        "group_rack": [
          "fields.Rack"
        ],
        "group_chassis": [
          "fields.Chassis"
        ]
      },
      "queryable_fields": [
        "@timestamp",
        "fields.Switch",
        "fields.Port",
        "fields.Location",
        "fields.Rack",
        "fields.Chassis",
        "fields.Slot",
        "fields.PhysicalContext",
        "fields.PhysicalSubContext",
        "fields.Value"
      ],
      "groupable_fields": [
        "fields.Switch",
        "fields.Rack",
        "fields.Chassis",
        "fields.Port",
        "fields.Location",
        "fields.PhysicalContext",
        "fields.PhysicalSubContext"
      ],
      "never_group": [
        "fields.Value"
      ],
      "output_projection": [
        "@timestamp",
        "fields.Switch",
        "fields.Port",
        "fields.Location",
        "fields.PhysicalContext",
        "fields.PhysicalSubContext",
        "fields.Value"
      ],
      "sensitivity": {
        "level": "internal",
        "redact_text_fields": true,
        "open_question": "OQ-PII",
        "redaction_note": "Heuristic masking of cued user names, e-mail and IP addresses is applied to every user-facing string (see skills/references/opensearch-logs/overview.md, Result metadata and limits). Not comprehensive PII detection."
      },
      "known_caveats": [
        "duplicate_reemission",
        "event_time_unreliable",
        "heartbeat_is_document_kind",
        "schema_varies_by_document_kind",
        "severity_vocabulary_per_index",
        "text_not_aggregatable"
      ],
      "severity_semantics": {
        "mode": "negative_healthy",
        "combine": "any",
        "fields": {
          "fields.PhysicalSubContext": {
            "normal": [
              "HEALTHY"
            ],
            "abnormal": [
              "CRITICAL"
            ],
            "other_known": [],
            "source": "Observed HEALTHY/CRITICAL in the sampled data; 'unhealthy = not HEALTHY' is the source team's own query definition.",
            "verification": "observed"
          }
        }
      }
    },
    {
      "pattern_id": "controller_log",
      "index_pattern": "controllerlog-*",
      "domain_reference": "references/opensearch-logs/controller-log.md",
      "enabled": true,
      "description": "Controller syslog-style messages per host and service",
      "date_rotation": {
        "style": "daily",
        "suffix": "-YYYY.MM.dd",
        "verified": false
      },
      "time_field": "@timestamp",
      "display_time_fields": [
        "Timestamp"
      ],
      "max_window": "7d",
      "roles": {
        "severity": [
          "Severity"
        ],
        "text": [
          "Body"
        ],
        "entity_host": [
          "Resource.host.name"
        ],
        "service": [
          "Resource.service.name"
        ],
        "entity_port": [
          "Attributes.PortName"
        ]
      },
      "queryable_fields": [
        "@timestamp",
        "Severity",
        "Body",
        "Resource.host.name",
        "Resource.service.name",
        "Attributes.facility",
        "Attributes.PortName",
        "Attributes.PortNumber"
      ],
      "groupable_fields": [
        "Resource.host.name",
        "Resource.service.name",
        "Severity",
        "Attributes.facility"
      ],
      "never_group": [
        "Body"
      ],
      "output_projection": [
        "@timestamp",
        "Resource.host.name",
        "Resource.service.name",
        "Severity",
        "Body"
      ],
      "sensitivity": {
        "level": "internal",
        "redact_text_fields": true,
        "open_question": "OQ-PII",
        "redaction_note": "Heuristic masking of cued user names, e-mail and IP addresses is applied to every user-facing string (see skills/references/opensearch-logs/overview.md, Result metadata and limits). Not comprehensive PII detection."
      },
      "known_caveats": [
        "event_time_unreliable",
        "ingest_lag_variable",
        "schema_varies_by_document_kind",
        "severity_vocabulary_per_index",
        "text_not_aggregatable"
      ],
      "severity_semantics": {
        "mode": "positive_abnormal",
        "combine": "any",
        "fields": {
          "Severity": {
            "normal": [
              "info",
              "notice",
              "debug"
            ],
            "other_known": [
              "warning",
              "warn"
            ],
            "abnormal": [
              "error",
              "err",
              "critical",
              "crit",
              "alert",
              "emerg"
            ],
            "source": "info/error/critical (and notice/warning) observed in sampled data; the remaining names (debug, warn, err, crit, alert, emerg) come from the syslog severity names (RFC 5424) and are not observed here.",
            "verification": "documented"
          }
        }
      }
    },
    {
      "pattern_id": "ilo_events",
      "index_pattern": "log_iml-*",
      "domain_reference": "references/opensearch-logs/ilo-events.md",
      "enabled": true,
      "description": "iLO / BMC Redfish event log entries",
      "date_rotation": {
        "style": "daily",
        "suffix": "-YYYY.MM.dd",
        "verified": false
      },
      "time_field": "@timestamp",
      "display_time_fields": [
        "Created"
      ],
      "max_window": "7d",
      "roles": {
        "severity": [
          "Severity",
          "Oem.Hpe.Severity"
        ],
        "text": [
          "Message"
        ],
        "entity_host": [
          "host"
        ],
        "event_code": [
          "Oem.Hpe.Code"
        ],
        "category": [
          "Oem.Hpe.Categories"
        ],
        "repaired": [
          "Oem.Hpe.Repaired"
        ],
        "recommended_action": [
          "Oem.Hpe.RecommendedAction"
        ]
      },
      "queryable_fields": [
        "@timestamp",
        "Severity",
        "Oem.Hpe.Severity",
        "Message",
        "host",
        "Oem.Hpe.Code",
        "Oem.Hpe.Categories",
        "Oem.Hpe.Repaired",
        "Oem.Hpe.RecommendedAction"
      ],
      "groupable_fields": [
        "host",
        "Severity",
        "Oem.Hpe.Severity",
        "Oem.Hpe.Code",
        "Oem.Hpe.Repaired",
        "Oem.Hpe.Categories"
      ],
      "never_group": [
        "Message",
        "Oem.Hpe.RecommendedAction"
      ],
      "output_projection": [
        "@timestamp",
        "Created",
        "host",
        "Severity",
        "Oem.Hpe.Severity",
        "Message",
        "Oem.Hpe.Code",
        "Oem.Hpe.RecommendedAction"
      ],
      "sensitivity": {
        "level": "internal",
        "redact_text_fields": true,
        "open_question": "OQ-PII",
        "redaction_note": "Heuristic masking of cued user names, e-mail and IP addresses is applied to every user-facing string (see skills/references/opensearch-logs/overview.md, Result metadata and limits). Not comprehensive PII detection."
      },
      "known_caveats": [
        "event_time_unreliable",
        "ingest_lag_variable",
        "severity_vocabulary_per_index",
        "text_not_aggregatable"
      ],
      "severity_semantics": {
        "mode": "positive_abnormal",
        "combine": "any",
        "fields": {
          "Severity": {
            "normal": [
              "OK"
            ],
            "other_known": [],
            "abnormal": [
              "Warning",
              "Critical"
            ],
            "source": "Only OK observed in the sampled iLO export (120,645 documents). Warning/Critical come from the DMTF Redfish LogEntry EventSeverity enumeration (OK, Warning, Critical); not observed in this deployment's data.",
            "verification": "documented"
          },
          "Oem.Hpe.Severity": {
            "normal": [
              "Informational"
            ],
            "other_known": [],
            "abnormal": [
              "Caution",
              "Warning",
              "Critical"
            ],
            "source": "Only Informational observed (120,645 documents). HPE's iLO log-services documentation names Caution and Critical (as severities of events that can be marked repaired); Warning is NOT documented there and is an assumption. The full vocabulary is unverified.",
            "verification": "provisional"
          }
        }
      }
    }
  ]
}
