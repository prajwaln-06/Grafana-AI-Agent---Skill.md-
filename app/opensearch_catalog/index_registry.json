{
  "registry_version": "1",
  "patterns": [
    {
      "pattern_id": "fabric_health",
      "index_pattern": "slingshot_crayfabrichealth-*",
      "domain_reference": "references/opensearch-logs/fabric-health.md",
      "enabled": true,
      "description": "Slingshot fabric health: heartbeat and fault documents",
      "date_rotation": { "style": "daily", "suffix": "-YYYY.MM.dd", "verified": false },
      "time_field": "@timestamp",
      "display_time_fields": ["fields.Timestamp", "timestamp"],
      "max_window": "7d",
      "roles": {
        "health_state": ["fields.PhysicalSubContext"],
        "event_kind": ["fields.PhysicalContext"],
        "text": ["fields.Value"],
        "entity_switch": ["fields.Switch"],
        "entity_port": ["fields.Port"],
        "entity_location": ["fields.Location"],
        "group_rack": ["fields.Rack"],
        "group_chassis": ["fields.Chassis"]
      },
      "queryable_fields": [
        "@timestamp", "fields.Switch", "fields.Port", "fields.Location", "fields.Rack",
        "fields.Chassis", "fields.Slot", "fields.PhysicalContext", "fields.PhysicalSubContext",
        "fields.Value"
      ],
      "groupable_fields": [
        "fields.Switch", "fields.Rack", "fields.Chassis", "fields.Port", "fields.Location",
        "fields.PhysicalContext", "fields.PhysicalSubContext"
      ],
      "never_group": ["fields.Value"],
      "output_projection": [
        "@timestamp", "fields.Switch", "fields.Port", "fields.Location",
        "fields.PhysicalContext", "fields.PhysicalSubContext", "fields.Value"
      ],
      "sensitivity": { "level": "internal", "redact_text_fields": false, "open_question": "OQ-PII" },
      "known_caveats": [
        "duplicate_reemission", "event_time_unreliable", "heartbeat_is_document_kind",
        "schema_varies_by_document_kind", "severity_vocabulary_per_index", "text_not_aggregatable"
      ]
    },
    {
      "pattern_id": "controller_log",
      "index_pattern": "controllerlog-*",
      "domain_reference": "references/opensearch-logs/controller-log.md",
      "enabled": true,
      "description": "Controller syslog-style messages per host and service",
      "date_rotation": { "style": "daily", "suffix": "-YYYY.MM.dd", "verified": false },
      "time_field": "@timestamp",
      "display_time_fields": ["Timestamp"],
      "max_window": "7d",
      "roles": {
        "severity": ["Severity"],
        "text": ["Body"],
        "entity_host": ["Resource.host.name"],
        "service": ["Resource.service.name"],
        "entity_port": ["Attributes.PortName"]
      },
      "queryable_fields": [
        "@timestamp", "Severity", "Body", "Resource.host.name", "Resource.service.name",
        "Attributes.facility", "Attributes.PortName", "Attributes.PortNumber"
      ],
      "groupable_fields": [
        "Resource.host.name", "Resource.service.name", "Severity", "Attributes.facility"
      ],
      "never_group": ["Body"],
      "output_projection": [
        "@timestamp", "Resource.host.name", "Resource.service.name", "Severity", "Body"
      ],
      "sensitivity": { "level": "internal", "redact_text_fields": false, "open_question": "OQ-PII" },
      "known_caveats": [
        "event_time_unreliable", "ingest_lag_variable", "schema_varies_by_document_kind",
        "severity_vocabulary_per_index", "text_not_aggregatable"
      ]
    },
    {
      "pattern_id": "ilo_events",
      "index_pattern": "log_iml-*",
      "domain_reference": "references/opensearch-logs/ilo-events.md",
      "enabled": true,
      "description": "iLO / BMC Redfish event log entries",
      "date_rotation": { "style": "daily", "suffix": "-YYYY.MM.dd", "verified": false },
      "time_field": "@timestamp",
      "display_time_fields": ["Created"],
      "max_window": "7d",
      "roles": {
        "severity": ["Severity", "Oem.Hpe.Severity"],
        "text": ["Message"],
        "entity_host": ["host"],
        "event_code": ["Oem.Hpe.Code"],
        "category": ["Oem.Hpe.Categories"],
        "repaired": ["Oem.Hpe.Repaired"],
        "recommended_action": ["Oem.Hpe.RecommendedAction"]
      },
      "queryable_fields": [
        "@timestamp", "Severity", "Oem.Hpe.Severity", "Message", "host", "Oem.Hpe.Code",
        "Oem.Hpe.Categories", "Oem.Hpe.Repaired", "Oem.Hpe.RecommendedAction"
      ],
      "groupable_fields": [
        "host", "Severity", "Oem.Hpe.Severity", "Oem.Hpe.Code", "Oem.Hpe.Repaired",
        "Oem.Hpe.Categories"
      ],
      "never_group": ["Message", "Oem.Hpe.RecommendedAction"],
      "output_projection": [
        "@timestamp", "Created", "host", "Severity", "Oem.Hpe.Severity", "Message",
        "Oem.Hpe.Code", "Oem.Hpe.RecommendedAction"
      ],
      "sensitivity": { "level": "internal", "redact_text_fields": false, "open_question": "OQ-PII" },
      "known_caveats": [
        "event_time_unreliable", "ingest_lag_variable", "severity_vocabulary_per_index",
        "text_not_aggregatable"
      ]
    }
  ]
}
