# Generated by scripts/generate_env_example.py from app/config.py -- do not edit by hand.
# Copy to .env and fill in the values marked REQUIRED.
# Every setting is read from the environment; the names are the field names in
# app/config.py, upper-cased. Lines starting with '# NAME=' show the default and
# are optional. Lists and objects are written as JSON.

# Google Gemini API key.
GEMINI_API_KEY=   # REQUIRED

# GEMINI_MODEL=gemini-3.5-flash-lite

# Directory that directly contains SKILL.md.
# SKILLS_ROOT=skills

# PROMETHEUS_URL=http://localhost:9090

# OpenSearch REST endpoint (port 9200; 9600 is the Performance Analyzer port, not the search API).
# OPENSEARCH_URL=http://localhost:9200

# OPENSEARCH_AUTH_USERNAME=

# OPENSEARCH_AUTH_PASSWORD=

# Index registry file. None = the packaged app/opensearch_catalog/index_registry.json.
# OPENSEARCH_REGISTRY_PATH=

# OPENSEARCH_FIELD_CATALOG_TTL_SECONDS=600.0

# How long a previously discovered catalog may still be served (marked stale) when a refresh
# fails. Must be >= the TTL.
# OPENSEARCH_FIELD_CATALOG_STALE_TTL_SECONDS=3600.0

# Newest N daily indices merged per pattern.
# OPENSEARCH_FIELD_CATALOG_MAX_INDICES=7

# OPENSEARCH_FIELD_CATALOG_FAILURE_BACKOFF_SECONDS=30.0

# OPENSEARCH_DEFAULT_HITS_SIZE=20

# OPENSEARCH_MAX_HITS_SIZE=100

# OPENSEARCH_DEFAULT_TERMS_SIZE=10

# OPENSEARCH_MAX_TERMS_SIZE=50

# OPENSEARCH_MAX_HISTOGRAM_BUCKETS=200

# Server-side search timeout added to every OpenSearch query (an expired timeout yields a partial
# result that is flagged).
# OPENSEARCH_SEARCH_TIMEOUT=10s

# OPENSEARCH_REDACT_USERNAMES=true

# mask_all | keep_internal (keep private/loopback addresses) | off.
# OPENSEARCH_REDACT_IP_MODE=mask_all

# PROMETHEUS_TIMEOUT_SECONDS=15.0

# OPENSEARCH_TIMEOUT_SECONDS=15.0

# Feature flag for the alert-rule-creation capability (SKILL.md Section 12). Defaults to OFF:
# while False, the Router/Generator prompts are built WITHOUT the alert-rule-creation addendum at
# all (see pipeline.py's _build_router_instructions/_build_generator_instructions), so an alert-
# creation request is classified exactly as it was before this capability existed
# (out_of_scope_action) -- there is no partial or inconsistent state. Turning this on does not by
# itself expose anything to end users beyond a PROPOSAL that still requires a separate, explicit
# confirmation call (see app/api/routes_alerts.py); it only controls whether that proposal step is
# reachable at all.
# ALERT_RULE_CREATION_ENABLED=false

# Base URL of the Grafana instance alert rules are created against. Required (and must point at a
# real, reachable Grafana) only if alert_rule_creation_enabled is True.
# GRAFANA_URL=http://localhost:3000

# Grafana service-account token used to authenticate provisioning-API requests (Authorization:
# Bearer <token>). Required if alert_rule_creation_enabled is True; grafana_client.py fails closed
# (returns a clear configuration-error outcome, never a silent no-op) if this is unset while the
# feature is enabled.
# GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Grafana folder UID that newly-created alert rules are provisioned into when the request doesn't
# (and SKILL.md Section 12.5 says it never does) specify one itself. Required if
# alert_rule_creation_enabled is True.
# GRAFANA_DEFAULT_FOLDER_UID=

# Grafana UID of the Prometheus datasource alert rule conditions are evaluated against -- this
# MUST be a datasource already configured in Grafana and pointing at the same Prometheus this
# backend queries via prometheus_url, or a proposed rule's condition_query will be evaluated
# against the wrong series entirely. Required if alert_rule_creation_enabled is True; resolved at
# confirmation time only (app/grafana_client.py), never by the Router or Generator (Section 12.5's
# datasource_uid: null rule).
# GRAFANA_DEFAULT_DATASOURCE_UID=

# GRAFANA_TIMEOUT_SECONDS=15.0

# Prometheus's own default sample cap, applied to Prometheus range queries only. The OpenSearch
# date_histogram bucket limit is opensearch_max_histogram_buckets.
# MAX_POINTS_PER_SERIES=11000

# Hard cap on series/buckets returned per result, protecting the frontend from an unbounded
# by(...)/terms grouping.
# MAX_SERIES_PER_RESULT=200

# MAX_HITS_PER_RESULT=500

# API_HOST=0.0.0.0

# API_PORT=8000

# Browser origins allowed to call this API (CORS). Env form is a JSON list, e.g.
# ["https://ui.example.com"]. "*" is only sensible for local use.
# CORS_ALLOW_ORIGINS=["*"]

# If set, required as the X-API-Key header on every request to this service. Unset (None) means
# open access -- fine for local dev, set this before deploying anywhere reachable outside your own
# machine.
# API_KEY=

# SESSION_TTL_SECONDS=600

# LABEL_DISCOVERY_LOOKBACK_HOURS=6

# How long a successfully discovered Prometheus label set per metric is reused. Failures are never
# cached. 0 disables caching.
# LABEL_DISCOVERY_CACHE_TTL_SECONDS=300.0

# Parallel /api/v1/series calls during label discovery.
# LABEL_DISCOVERY_MAX_WORKERS=8

# Overall budget across all LLM phases for one request, independent of each call's own
# retry/backoff.
# PIPELINE_TIMEOUT_SECONDS=45.0

# Path to the generated metric catalog (produced by scripts/generate_production_catalog.py from
# the vendor metric document; see app/catalog/vendor_docx.py), loaded lazily on first use and
# cached for the life of the process for the normal query path (Router-level narrowing and
# Generator-level candidate construction; see app/pipeline.py's `_get_catalog`). A missing or
# invalid file at this path never crashes the pipeline -- the whole catalog-
# narrowing/candidate/fallback architecture silently disables itself (logged once) and every
# request behaves exactly as it would with no catalog at all: full unnarrowed Section 4, no
# Generator candidate block, no Level-1/2/3.
# CATALOG_PATH=app/catalog/catalog.json

# Minimum score the TOP catalog-search candidate must clear before Router-level Section 4
# narrowing or Generator-level Level-1 candidate construction will act on it at all; a non-empty
# search result below this floor is treated exactly like a catalog miss (full, unnarrowed Section
# 4; no Level-1 candidate block). The review finding this exists for was that 'a non-empty catalog
# search result is not necessarily a safe routing result' -- this is the conservative half of that
# fix (the other half is that narrowing/candidate search itself does not truncate by rank; see
# pipeline.py's _NARROW_SEARCH_TOP_N). The default (2.0) is set relative to search.py's own field
# weights: it rules out a candidate whose ENTIRE score comes from a single incidental 'help' or
# 'exporter' token match (weight 1.0 each, search.py's own docstring calls free-prose help text
# 'most likely to contain incidental word overlap'), while still passing any single category match
# (weight 2.0) or stronger. It intentionally does NOT attempt to fix moderate-scoring false
# positives from genuine name/keyword overlap on the wrong metric (e.g. a query containing the
# word 'total' matching an unrelated *_TOTAL metric name) -- that is a scoring-precision problem
# for a future weight-tuning phase, not something a single global threshold can safely resolve
# without also cutting correct matches that score just as low. See
# scripts/evaluate_catalog_retrieval.py's reference-level report for the measured breakdown.
# CATALOG_NARROW_MIN_SCORE=2.0

# When True, app/validator.py's deterministic checks additionally look up each Prometheus-backed
# query/alert metric's catalog status and reject the metric outright if that status is
# 'discovered_pending_review' or 'rejected' -- even if the same metric name also happens to appear
# in a Metric Directory this request opened (the existing `known_metrics` check). This is strictly
# additive/supplementary: it can only make an already-known metric MORE restricted, never less --
# it never overrides a `known_metrics` rejection, and it never makes a fabricated metric name
# valid. Deliberately kept as a genuine, independent opt-in capability (NOT removed alongside the
# migration flags above): unlike Router narrowing or Generator candidates, this is not 'old vs new
# pipeline shape' -- it is an optional stricter enforcement rule a deployment may reasonably not
# want on immediately (e.g. one whose catalog.json currently has many entries still sitting in
# `discovered_pending_review`). While False (the default), validator.py's known_metrics behavior
# is byte-for-byte what it was before this flag existed. If the catalog fails to load, or this
# deployment has no catalog at all, this degrades to 'no catalog-status information available'
# (validation proceeds on known_metrics alone) rather than rejecting every metric or crashing the
# request -- consistent with every other catalog setting's 'catalog integration is additive, never
# a new single point of failure' convention.
# CATALOG_METRIC_STATUS_VALIDATION_ENABLED=false

# Path to the human-review store (explicit approve/reject decisions, see app/catalog/reviews.py).
# Separate from catalog_path: the vendor catalog is never edited by reviews. A MISSING file means
# 'no decisions yet'; a file that exists but is malformed or self-conflicting makes the runtime
# refresh fail closed (the previous snapshot stays in place). In a container this must live on a
# mounted volume shared with whoever runs scripts/review_catalog.py, or decisions are lost on
# redeploy.
# CATALOG_REVIEWS_PATH=app/catalog/reviews.json

# When True, the server starts a background thread (app/catalog/runtime.py) that discovers metrics
# from prometheus_url at startup and every catalog_runtime_refresh_seconds, reconciles them with
# the vendor catalog and review decisions, and publishes the result as the catalog the query
# pipeline uses (statuses approved / approved_unavailable / discovered_pending_review / rejected).
# Also turns on catalog-status validation (see catalog_metric_status_validation_enabled), because
# the statuses it enforces only exist once this is on. Discovery never runs inside a user request,
# and a failed discovery keeps the last good snapshot. Defaults to OFF: the pipeline then uses the
# vendor catalog plus review decisions, with no availability data.
# CATALOG_RUNTIME_RECONCILIATION_ENABLED=false

# Seconds between runtime reconciliation refreshes (only used when
# catalog_runtime_reconciliation_enabled is True). Each refresh makes two Prometheus API calls
# (label values + metadata).
# CATALOG_RUNTIME_REFRESH_SECONDS=300.0

# Shell-style globs (case-sensitive), e.g. ["node_*", "DCGM_*"]. When non-empty, only runtime-
# discovered metrics matching at least one pattern are queued as 'discovered_pending_review'.
# Empty (default) = no include restriction. Env var form is a JSON list. Affects ONLY which new,
# unknown metrics enter the review queue -- never the availability of vendor/approved metrics, and
# never a human rejection.
# CATALOG_DISCOVERY_INCLUDE_PATTERNS=[]

# Shell-style globs for runtime-discovered metrics that must never be queued for review, e.g.
# ["go_*", "process_*", "scrape_*"] to keep Prometheus's own and generic client-library metrics
# out of the review queue. Exclusion wins over inclusion. Empty (default) = nothing excluded.
# Nothing is excluded by default because which metrics are noise depends on the deployment.
# CATALOG_DISCOVERY_EXCLUDE_PATTERNS=[]

# Feature flag for the opt-in path (see app/pipeline.py's module docstring, 'Dependency-aware
# compound query resolution') that lets a compound question's later query reuse the resolved
# result of an earlier query in the SAME question -- e.g. 'which node has the highest CPU
# utilization, and how much memory is available on that node?'. Defaults to OFF: while False, the
# Router prompt, the Generator prompt, the existing one-shot construction flow, and the flat
# (single-executor-pass) execution flow are all kept byte-for-byte unchanged -- there is zero
# prompt or control-flow change for a deployment that hasn't opted in. When True, the Router may
# annotate each matched reference with `intent_id`/`depends_on`; a genuine, validated dependency
# plan is resolved in stages (root intents, then each dependent intent
# generated/validated/executed once its parent's data is available) instead of a single flat
# Generator call, and the pipeline executes the result itself before returning (see
# `pipeline.ALREADY_EXECUTED_MARKER`, checked by app/agent.py so it never re-executes the same
# queries a second time). Invalid or absent dependency metadata for a given question -- incomplete
# tagging, an unknown `depends_on` id, a self-dependency, a cycle, or simply no question that
# declares one -- always degrades to exactly the existing flat path for that request, never a
# crash or a blocked request.
# DEPENDENT_QUERY_RESOLUTION_ENABLED=false
