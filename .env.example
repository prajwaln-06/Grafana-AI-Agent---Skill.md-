# ============================================================================
# LLM Configuration
# ============================================================================
# Provider is explicit. Default: gemini_api (Gemini Developer API / AI Studio).
# Vertex AI is used ONLY when LLM_PROVIDER=vertex. A GEMINI_API_KEY is never
# sent to Vertex AI, and no GCP project is assumed.
LLM_PROVIDER=gemini_api
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# --- Only when LLM_PROVIDER=vertex: choose ONE auth mode ---
# (a) project + Application Default Credentials:
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=global
# (b) Vertex express mode with a Vertex AI API key (prefix "AQ."):
# VERTEX_API_KEY=your_vertex_api_key_here

# ============================================================================
# Skill Package & Feature Flags
# ============================================================================
SKILLS_ROOT=skills
ALERT_RULE_CREATION_ENABLED=true
DEPENDENT_QUERY_RESOLUTION_ENABLED=true

# ============================================================================
# Structured Prometheus Metric Catalog (app/catalog/)
# Separate from the dashboard UI catalog at app/catalog.json.
# ============================================================================
# Structured metric catalog used to rank candidate metrics for the Generator.
CATALOG_PATH=app/catalog/catalog.json
# Minimum catalog search score before candidates are shown to the Generator.
CATALOG_NARROW_MIN_SCORE=2.0
# Reject metrics whose catalog status is discovered_pending_review/rejected.
CATALOG_METRIC_STATUS_VALIDATION_ENABLED=false

# ============================================================================
# Telemetry Backends (Read-only query execution)
# ============================================================================
# Host endpoints published by the root docker-compose.yml stack.
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_AUTH_USERNAME=
OPENSEARCH_AUTH_PASSWORD=
PROMETHEUS_TIMEOUT_SECONDS=15.0
OPENSEARCH_TIMEOUT_SECONDS=15.0

# ============================================================================
# Grafana OSS & FastMCP Bridge
# ============================================================================
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_grafana_service_account_token_here
GRAFANA_DEFAULT_FOLDER_UID=afvlix95l3wg0d
GRAFANA_DEFAULT_DATASOURCE_UID=PBFA97CFB590B2093
GRAFANA_TIMEOUT_SECONDS=15.0
GRAFANA_MCP_ENABLE_WRITE=true

# ============================================================================
# Response Safety Limits
# ============================================================================
MAX_POINTS_PER_SERIES=11000
MAX_SERIES_PER_RESULT=200
MAX_HITS_PER_RESULT=500

# ============================================================================
# HTTP API Server Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8008
PORT=8008
CORS_ALLOW_ORIGINS=["*"]
API_KEY=

# ============================================================================
# Authentik (OpenID Connect) authentication
# ============================================================================
# The browser authenticates against Authentik with the OIDC Authorization
# Code flow. There is no reverse proxy in front of the application: the vite
# dev server publishes the UI on :5173 and proxies /api to the FastAPI
# backend on :8008. The OIDC callback
# (http://localhost:5173/api/auth/callback) is therefore served by the
# backend through that same proxy.
#
# Ports:
#   :5173  the application (vite dev server + /api proxy) -- the ONE normal
#          application URL
#   :8008  the FastAPI backend
#   :9000  the Authentik server / admin interface (its own compose project)
#
# DEVELOPMENT MODE: while AUTHENTIK_ENABLED=false every API endpoint is
# reachable without an identity. That is a local-development convenience and
# is NOT a security control. Set it to true before exposing the service.
AUTHENTIK_ENABLED=false

# Browser-visible base URL of the Authentik instance (its admin interface
# lives here too). Used to build the link to Authentik's enrollment and
# password-change flows.
AUTHENTIK_BASE_URL=http://localhost:9000

# Slug of the Authentik application the OIDC provider belongs to. It is
# part of the discovery URL below.
AUTHENTIK_APP_SLUG=grafana-ai-agent

# OIDC discovery document of the Authentik provider. Authentik serves it at
# /application/o/<application-slug>/.well-known/openid-configuration
AUTHENTIK_OIDC_DISCOVERY_URL=http://localhost:9000/application/o/grafana-ai-agent/.well-known/openid-configuration

# OIDC client id of the Authentik application (a confidential client).
# Obtain it in the Authentik admin interface: Applications -> Providers ->
# <your provider> -> Edit. Do not guess it: it must be the id of the
# provider that is attached to the application.
AUTHENTIK_OIDC_CLIENT_ID=

# OIDC client secret of the Authentik application. Server-side only: it
# never reaches the browser. Obtain it from the same admin page.
AUTHENTIK_OIDC_CLIENT_SECRET=

# EXACT redirect URI registered in the Authentik provider. It must match
# the URL the browser is sent back to, character for character (scheme,
# host, port and path).
AUTHENTIK_OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Scopes requested in the authorization request.
AUTHENTIK_OIDC_SCOPE=openid profile email

# Use PKCE (S256) in the authorization request. Keep it on.
AUTHENTIK_OIDC_PKCE=true

# Timeout for the discovery, JWKS and token requests.
AUTHENTIK_OIDC_HTTP_TIMEOUT_SECONDS=10

# Secret used to sign the application-session cookie. Generate one with:
#   openssl rand -hex 32
AUTHENTIK_SESSION_SECRET=

# Lifetime of the application session, in seconds.
AUTHENTIK_SESSION_MAX_AGE_SECONDS=3600

# Name of the session cookie and its flags.
AUTHENTIK_SESSION_COOKIE_NAME=grafana_ai_session
# Set to true when the application is served over HTTPS.
AUTHENTIK_SESSION_COOKIE_SECURE=false
# "lax" is required for the cookie to survive the redirect back from
# Authentik.
AUTHENTIK_SESSION_COOKIE_SAMESITE=lax

# Slug of the Authentik ENROLLMENT flow that the "Create account" link
# opens. Authentik ships such a flow as the example blueprint
# "example/flows-enrollment-2-stage.yaml" (designation: enrollment, slug:
# default-enrollment-flow). Import it in Authentik under
# Admin -> Flows and Stages -> Flows -> Import, or point this at your own
# enrollment flow.
AUTHENTIK_ENROLLMENT_FLOW=default-enrollment-flow

# Optional: an explicit URL for the sign-up flow, overriding the URL built
# from AUTHENTIK_BASE_URL + AUTHENTIK_ENROLLMENT_FLOW. Use it when the flow
# needs extra query parameters (for example an invitation link).
AUTHENTIK_SIGNUP_URL=

# Slug of the Authentik flow that lets a signed-in user change their own
# password (it contains the "Password change" stage). Authentik ships it as
# "default-password-change"; link that flow to the provider's user-settings
# flow so an ordinary user can reach it.
AUTHENTIK_PASSWORD_CHANGE_FLOW=default-password-change

# Optional: an explicit URL for the password-change flow, overriding the URL
# built from AUTHENTIK_BASE_URL + AUTHENTIK_PASSWORD_CHANGE_FLOW.
AUTHENTIK_PASSWORD_CHANGE_URL=

# ============================================================================
# Session Store & Timeout Settings
# ============================================================================
SESSION_TTL_SECONDS=600
LABEL_DISCOVERY_LOOKBACK_HOURS=6
PIPELINE_TIMEOUT_SECONDS=45.0
ADK_PROXY_TIMEOUT_MS=30000
BACKEND_TIMEOUT_MS=30000
